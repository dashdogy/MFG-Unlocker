# MFG Unlocker menu, Ukrainian.
# Segoe UI draws Cyrillic, so no extra font is listed.
msgid ""
msgstr ""
"Project-Id-Version: MFG Unlocker\n"
"Language: uk_UA\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-MFG-Native-Name: Українська\n"
"X-MFG-English-Name: Ukrainian\n"
"X-MFG-Match: uk\n"

msgid "Auto (%s)"
msgstr "Авто (%s)"

msgid "Menu language"
msgstr "Мова меню"

