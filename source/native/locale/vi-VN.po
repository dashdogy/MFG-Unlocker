msgstr "Chẩn đoán XeSS"

msgid "DLSS presets"
msgstr "Preset DLSS"

msgid "Frame generation is set in OptiScaler's menu. This menu offers the DLSS presets and DLSS 5."
msgstr "Frame Generation được chỉnh trong menu của OptiScaler. Menu này có các preset DLSS và DLSS 5."

msgid "DLSS 5"
msgstr "DLSS 5"

msgid "Present does not run from OptiScaler's menu. Choose Auto, Before upscaling or After upscaling."
msgstr "Xuất khung hình không chạy từ menu của OptiScaler. Hãy chọn Tự động, Trước khi upscale hoặc Sau khi upscale."

msgid "XeFG"
msgstr "XeFG"

msgid "CUDA port"
msgstr "Bản port CUDA"

msgid "int8 layers on the tensor cores"
msgstr "các layer int8 chạy trên Tensor cores"

msgid "XMX port"
msgstr "Bản port XMX"

msgid "on the shader cores"
msgstr "trên shader cores"

msgid "XMX port: MFG Unlocker's port of Intel's multi-frame XMX model, run as DXIL shaders on any GPU. CUDA port: the same model with its int8 layers run as CUDA kernels on RTX tensor cores."
msgstr "Bản port XMX: bản port của MFG Unlocker cho model Multi-Frame XMX của Intel, chạy dưới dạng shader DXIL trên mọi GPU. Bản port CUDA: cùng model đó, với các layer int8 chạy dưới dạng CUDA kernel trên Tensor cores của RTX."

msgid "Waiting for current backend status. Saved settings are preserved."
msgstr "Đang chờ trạng thái backend. Các thiết lập đã lưu vẫn được giữ nguyên."

msgid "Status is temporarily unavailable; controls are paused."
msgstr "Trạng thái tạm thời không khả dụng; các tùy chỉnh đang tạm dừng."

msgid "Keybinds"
msgstr "Phím tắt"

msgid "FPS readout on"
msgstr "Đã bật hiển thị FPS"

msgid "FPS readout off"
msgstr "Đã tắt hiển thị FPS"

msgid "Raise multiplier"
msgstr "Tăng hệ số nhân"

msgid "Lower multiplier"
msgstr "Giảm hệ số nhân"

msgid "Dynamic on/off"
msgstr "Bật/tắt Dynamic"

msgid "FPS readout on/off"
msgstr "Bật/tắt hiển thị FPS"

msgid "Pin panel"
msgstr "Ghim bảng"

msgid "Next preset"
msgstr "Preset tiếp theo"

msgid "Previous preset"
msgstr "Preset trước"

msgid "Frame generation keys apply once frame generation is ready"
msgstr "Phím Frame Generation sẽ hoạt động khi Frame Generation sẵn sàng"

msgid "Applying the last change..."
msgstr "Đang áp dụng thay đổi trước..."

msgid "XeMFG: %s"
msgstr "XeMFG: %s"

msgid "Frame generation: %s"
msgstr "Frame Generation: %s"

msgid "%s is unavailable right now"
msgstr "%s hiện không khả dụng"

msgid "Highest mode here: %s"
msgstr "Chế độ cao nhất ở đây: %s"

msgid "Lowest mode: %s"
msgstr "Chế độ thấp nhất: %s"

msgid "The change could not be saved"
msgstr "Không thể lưu thay đổi"

msgid "DLSS preset keys apply while the game runs DLSS"
msgstr "Phím preset DLSS hoạt động khi game đang dùng DLSS"

msgid "RR preset: %s"
msgstr "Preset RR: %s"

msgid "SR preset: %s"
msgstr "Preset SR: %s"

msgid "the menu key"
msgstr "phím menu"

msgid "%s is already used by %s"
msgstr "%s đã được dùng cho %s"

msgid "Moved from %s"
msgstr "Đã chuyển từ %s"

msgid "The frame generation in use has no such mode."
msgstr "Frame Generation đang dùng không có chế độ này."

msgid "Steps through the modes the Mode list offers."
msgstr "Lần lượt chuyển qua từng chế độ mà danh sách Chế độ cung cấp."

msgid "Steps through the presets of the DLSS the game runs: Super Resolution's (J, K, L, M) or, while Ray Reconstruction runs, Ray Reconstruction's (D, E, F). After the last one it starts again."
msgstr "Lần lượt chuyển qua các preset của DLSS mà game đang dùng: của Super Resolution (J, K, L, M) hoặc, khi Ray Reconstruction đang chạy, của Ray Reconstruction (D, E, F). Sau preset cuối sẽ quay lại từ đầu."

msgid "Also used by %s"
msgstr "Cũng được dùng cho %s"

msgid "Keys work with the menu open or closed, and still reach the game."
msgstr "Phím hoạt động khi menu mở hoặc đóng, và game vẫn nhận được phím."

msgid "To bind a combination, hold Ctrl, Shift or Alt and press the key. A combination avoids the game's own keys."
msgstr "Để gán tổ hợp, giữ Ctrl, Shift hoặc Alt rồi bấm phím. Tổ hợp phím giúp tránh trùng với phím của game."

msgid "Frame generation is set in OptiScaler's menu, so its keys are not offered here."
msgstr "Frame Generation được chỉnh trong menu của OptiScaler, nên các phím của nó không có ở đây."

msgid "Now applies to %s"
msgstr "Hiện áp dụng cho %s"

msgid "Show a note when a key changes a setting"
msgstr "Hiện ghi chú khi phím thay đổi một thiết lập"

msgid "The keybinds work for this session, but could not be saved."
msgstr "Phím tắt hoạt động trong phiên này nhưng không lưu được."

msgid "Waiting for status"
msgstr "Đang chờ trạng thái"

msgid "Not connected"
msgstr "Chưa kết nối"

msgid "%s backend is not loaded."
msgstr "Chưa load backend %s."

msgid "The integrated core is unavailable. Check the startup log and restart the game with one %s module."
msgstr "Core tích hợp không khả dụng. Hãy kiểm tra log khởi động và restart game chỉ với một module %s duy nhất."

msgid "Paused"
msgstr "Tạm dừng"

msgid "The game changed graphics adapters. Restart the game to select a new GPU."
msgstr "Game đã đổi GPU xuất hình. Hãy khởi động lại game để nhận diện GPU mới."

msgid "RTX Remix detected. Frame generation and its multiplier are managed in the RTX Remix menu."
msgstr "Đã phát hiện RTX Remix. Frame Generation và hệ số nhân được quản lý trực tiếp trong menu RTX Remix."

msgid "Provider patch"
msgstr "Patch provider"

msgid "Ready at feature creation"
msgstr "Sẵn sàng khi khởi tạo tính năng"

msgid "Waiting for frame generation"
msgstr "Đang chờ Frame Generation"

msgid "Restart with the matching single-module build. The current status protocol is older than this UI expects."
msgstr "Hãy restart game với bản build đơn module phù hợp. Giao thức trạng thái hiện tại cũ hơn phiên bản giao diện cần."

msgid "5x MFG (experimental)"
msgstr "5x MFG (thử nghiệm)"

msgid "6x MFG (experimental)"
msgstr "6x MFG (thử nghiệm)"

msgid "Follow game"
msgstr "Theo game"

msgid "Mode"
msgstr "Chế độ"

msgid ""
"Follow game uses the game's own frame generation setting.\n"
"Dynamic adjusts frame generation toward a target frame rate; it does not set a hard FPS limit."
msgstr ""
"\"Theo game\" sẽ dùng thiết lập Frame Gen mặc định của game.\n"
"\"Dynamic\" tự điều chỉnh số frame nội suy để đạt mức FPS mục tiêu; không phải là giới hạn FPS cứng."

msgid "DLSS frame generation could not start on this GPU, so it stays off for this session. Restart the game to try again."
msgstr "Không thể khởi động DLSS Frame Generation trên card đồ họa này, nên tính năng sẽ tắt trong phiên này. Hãy khởi động lại game để thử lại."

msgid "Frame generation stays under the game's control. This wrapper has no verified MFG override support."
msgstr "Frame Generation vẫn do game kiểm soát. Wrapper này chưa hỗ trợ override MFG chính thức."

msgid "DLSS-G activity observed; waiting for the game's FG control calls."
msgstr "Đã phát hiện DLSS-G hoạt động; đang chờ lệnh điều khiển FG từ game."

msgid "Waiting for the game to request frame generation."
msgstr "Đang chờ game yêu cầu bật Frame Generation."

msgid "Waiting for an active DLSS-G pipeline."
msgstr "Đang chờ pipeline DLSS-G hoạt động."

msgid "Toggle frame generation off then on, or restart the game, to recreate the pipeline with this selection."
msgstr "Bật tắt lại Frame Generation hoặc khởi động lại game để tạo lại pipeline với thiết lập mới này."

msgid "Dynamic MFG is unavailable with the current limit or runtime. Its full frame-generation range must fit the limit."
msgstr "Dynamic MFG không khả dụng với mức giới hạn hoặc runtime hiện tại. Toàn bộ dải tạo khung hình phải nằm gọn trong giới hạn này."

msgid "Dynamic selection is saved; waiting for runtime support."
msgstr "Đã lưu tùy chọn Dynamic; đang chờ runtime hỗ trợ."

msgid "Saved MFG request: %dx (unavailable in this session)"
msgstr "Mức MFG đã lưu: %dx (không khả dụng trong phiên này)"

msgid "Request accepted, but the configuration was not saved."
msgstr "Đã nhận yêu cầu, nhưng chưa lưu cấu hình."

msgid "The selection could not be applied or saved."
msgstr "Không thể áp dụng hoặc lưu tùy chọn đã chọn."

