msgid ""
"Keeps this panel on screen, see-through and click-through.\n"
"%s brings the menu back."
msgstr ""
"Ghim bảng này trên màn hình (nhìn xuyên và click xuyên qua).\n"
"Bấm %s để mở lại menu."

msgid "Pinned  |  %s brings the menu back"
msgstr "Đã ghim  |  Bấm %s để mở lại menu"

msgid "Menu key: %s"
msgstr "Phím menu: %s"

msgid "Shared with OptiScaler's menu"
msgstr "Dùng chung với menu của OptiScaler"

