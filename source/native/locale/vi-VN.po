# Segoe UI draws Vietnamese, so no extra font is listed.
msgid ""
msgstr ""
"Project-Id-Version: MFG Unlocker\n"
"Language: vi_VN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-MFG-Native-Name: Tiếng Việt\n"
"X-MFG-English-Name: Vietnamese\n"
"X-MFG-Match: vi\n"

