msgstr "Không có điểm chờ"

msgid "the game's frames reach no sleep before their input"
msgstr "khung hình của trò chơi không có khoảng chờ nào trước khi đọc thao tác"

msgid "the game is not held in Present"
msgstr "trò chơi không bị giữ trong Present"

msgid "%.1f ms sooner"
msgstr "sớm hơn %.1f ms"

msgid "of %.1f ms the game waited in Present"
msgstr "trong %.1f ms trò chơi chờ trong Present"

