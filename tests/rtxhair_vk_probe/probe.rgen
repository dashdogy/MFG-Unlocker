#version 460
// vkhair.1 phase 0, pass 2: ray tracing pipeline. One launch per ray; the closest hit (probe.rchit)
// or the miss shader writes the result.
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "probe_common.glsl"

layout(location = 0) rayPayloadEXT uint payload;

void main()
{
    uint i = gl_LaunchIDEXT.x;
    if (i >= params.rayCount)
        return;
    RayIn r = rays[params.rayOffset + i];
    payload = 0u;
    traceRayEXT(Scene, gl_RayFlagsOpaqueEXT, r.mask & 0xFFu, 0, 1, 0, r.origin, 0.0, r.direction, r.tmax, 0);
}
